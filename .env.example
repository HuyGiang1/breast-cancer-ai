# Runtime mode
APP_ENV=production
APP_FRONTEND_URL=http://127.0.0.1:8080
APP_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:5500,http://localhost:5500
APP_MAX_IMAGE_UPLOAD_MB=20

# AI advisor / OCR fallback
# Use "local" for fully offline rule-based advice.
AI_ADVISOR_PROVIDER=local
AI_ADVISOR_TIMEOUT=20

# Optional Gemini provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional OpenAI-compatible provider
OPENAI_API_KEY=
AI_ADVISOR_MODEL=gpt-4o-mini
AI_ADVISOR_BASE_URL=https://api.openai.com/v1/chat/completions

# Deep learning runtime
FINAL_ML_MODEL_PATH=/app/runtime_models/logistic_regression_final_seed42.joblib
FINAL_DL_MODEL_PATH=/app/runtime_models/efficientnetb0_final_seed42.keras
DL_PRELOAD_ON_STARTUP=true

# Mail delivery
# "file" writes reset tokens to backend/data/outbox for local development.
# "smtp" sends email and does not return reset tokens in API responses.
APP_MAIL_MODE=file
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Breast Health Studio

# Google OAuth (Sign In With Google / GIS)
# Configure with Web Application OAuth Client ID from Google Cloud Console.
# Leave blank to disable Google Sign-In.
GOOGLE_CLIENT_ID=

# Doctor Registration Access Mode
# "disabled": doctor registration is blocked; all new accounts are Personal / role="user".
# "invite": doctor registration requires a valid DOCTOR_INVITE_CODE via constant-time comparison.
DOCTOR_REGISTRATION_MODE=disabled
DOCTOR_INVITE_CODE=
