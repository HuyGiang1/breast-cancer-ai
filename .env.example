# ==============================================================================
# Breast Cancer AI — Local Development Environment Configuration
# Copy to .env for local development: cp .env.example .env
# ==============================================================================

# Runtime mode: "development" enables local origins and debug tools
APP_ENV=development
APP_ENABLE_API_DOCS=true
APP_FRONTEND_URL=http://127.0.0.1:8080
APP_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:3000,http://localhost:3000
APP_MAX_IMAGE_UPLOAD_MB=20

# AI advisor / OCR fallback
# Use "local" for offline rule-based clinical guidance.
AI_ADVISOR_PROVIDER=local
AI_ADVISOR_TIMEOUT=20

# Optional Gemini provider (leave blank for local fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional OpenAI-compatible provider (leave blank for local fallback)
OPENAI_API_KEY=
AI_ADVISOR_MODEL=gpt-4o-mini
AI_ADVISOR_BASE_URL=https://api.openai.com/v1/chat/completions

# Model artifacts (paths inside container or local host)
FINAL_ML_MODEL_PATH=models/logistic_regression_final_seed42.joblib
FINAL_DL_MODEL_PATH=models/efficientnetb0_final_seed42.keras
DL_PRELOAD_ON_STARTUP=true

# Mail delivery mode
# "file" writes reset emails to backend/data/outbox/ and includes token in dev API responses.
# "smtp" sends live email via configured server.
APP_MAIL_MODE=file
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=dev@example.local
SMTP_FROM_NAME=Breast Health Studio (Local)

# Google OAuth (Sign In With Google / GIS)
# Web Application OAuth Client ID from Google Cloud Console.
# Leave blank to disable Google Sign-In during local development.
GOOGLE_CLIENT_ID=

# Doctor Registration Access Mode
# "disabled": doctor registration blocked; all new accounts are Personal / role="user".
# "invite": doctor registration requires a valid DOCTOR_INVITE_CODE.
DOCTOR_REGISTRATION_MODE=invite
DOCTOR_INVITE_CODE=dev-doctor-invite-code
