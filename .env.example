# Runtime mode
APP_ENV=development
APP_FRONTEND_URL=http://127.0.0.1:8080
APP_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:5500,http://localhost:5500
APP_MAX_IMAGE_UPLOAD_MB=20

# AI advisor / OCR fallback
# Use "local" for fully offline rule-based advice.
AI_ADVISOR_PROVIDER=local
AI_ADVISOR_TIMEOUT=20

# Optional Gemini provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional OpenAI-compatible provider
OPENAI_API_KEY=
AI_ADVISOR_MODEL=gpt-4o-mini
AI_ADVISOR_BASE_URL=https://api.openai.com/v1/chat/completions

# Deep learning runtime
DL_PRELOAD_ON_STARTUP=false
DL_EXPOSE_EXPERIMENTAL_MODELS=false
DL_SKIP_HEALTH_CHECK=true
DL_HEALTH_CHECK_SAMPLES=40
DL_PROBABILITY_POSTPROCESS_MODE=spread

# Mail delivery
# "file" writes reset tokens to backend/data/outbox for local development.
# "smtp" sends email and does not return reset tokens in API responses.
APP_MAIL_MODE=file
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=BreastCare Mint
