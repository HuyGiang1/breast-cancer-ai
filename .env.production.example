# ==============================================================================
# Breast Health Studio — Production Environment Template
# Copy this file to .env on the production host and populate with real secrets:
#   cp .env.production.example .env
# DO NOT COMMIT REAL PRODUCTION SECRETS TO VERSION CONTROL!
# ==============================================================================

# Core Runtime Mode (Must be "production")
APP_ENV=production

# Disable Swagger UI and ReDoc in production for security hardening
APP_ENABLE_API_DOCS=false

# Canonical HTTPS URL of the frontend application (No trailing slash)
APP_FRONTEND_URL=https://bcai.example.com

# Explicit allowed CORS origins (Comma-separated HTTPS origins only, no trailing slash, no wildcards, no localhost)
APP_CORS_ORIGINS=https://bcai.example.com

# Maximum upload payload limit in Megabytes (recommended: 20)
APP_MAX_IMAGE_UPLOAD_MB=20

# AI advisor / OCR Clinical Guidance Provider
# Options: "local" (safe offline heuristic), "gemini", or "openai"
AI_ADVISOR_PROVIDER=local
AI_ADVISOR_TIMEOUT=20

# Optional Gemini Cloud API Key (Required only if AI_ADVISOR_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional OpenAI Cloud API Key (Required only if AI_ADVISOR_PROVIDER=openai)
OPENAI_API_KEY=
AI_ADVISOR_MODEL=gpt-4o-mini
AI_ADVISOR_BASE_URL=https://api.openai.com/v1/chat/completions

# Model artifacts runtime paths (within Docker container or host)
FINAL_ML_MODEL_PATH=/app/runtime_models/logistic_regression_final_seed42.joblib
FINAL_DL_MODEL_PATH=/app/runtime_models/efficientnetb0_final_seed42.keras
DL_PRELOAD_ON_STARTUP=true

# Database Path
DATABASE_PATH=/app/backend/data/app.db

# Production Mail Delivery Configuration (Provider-Neutral)
# In production, reset_token is NEVER disclosed in API responses.
APP_MAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Breast Health Studio

# Google Identity Services (GIS) OAuth Client ID
# Format: <unique-id>.apps.googleusercontent.com
# Authorized Javascript Origins in Google Cloud Console must include your production domain: https://bcai.example.com
GOOGLE_CLIENT_ID=

# Doctor Registration Access Control
# Default is "disabled" to ensure zero unauthorized doctor registrations.
# If the operator intentionally enables doctor registration ("invite"), a high-entropy secret
# must be generated directly on the server (e.g. python3 -c "import secrets; print(secrets.token_urlsafe(32))").
DOCTOR_REGISTRATION_MODE=disabled
DOCTOR_INVITE_CODE=
